# Default provider
LLM_PROVIDER=ollama_chat # openai, anthropic, gemini, ollama_chat, mistral, etc.

# Default model
LLM_MODEL=gemma4:e4b

# Options
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=

# Provider-specific API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Generic OpenAI-compatible / local endpoint settings
LLM_API_BASE=http://localhost:11434
# Optional override. Leave blank to auto-use the provider key above.
LLM_API_KEY=

# Loïc personal API (FastAPI backend wrapping llama.cpp with auth + memory).
# LOIC_API_BASE overrides LLM_API_BASE when set. Provider is auto-detected
# from the hostname (loic.exaload.fr / loic.exaload.app), the API key is read
# from LOIC_API_KEY, and LOIC_MODEL overrides LLM_MODEL when the active base
# URL is a Loïc endpoint — so you can keep distinct model ids per provider.
LOIC_API_BASE=https://loic.exaload.fr/api/v1
LOIC_API_KEY=
LOIC_MODEL=gemma-4-E4B-Q4

# Optional integration endpoints
SAGEMATH_HOST_PORT=18000
SEARXNG_HOST_PORT=8080
SAGEMATH_MCP_URL=http://127.0.0.1:18000/mcp
SEARXNG_BASE_URL=http://127.0.0.1:8080  # No API key required for SearXNG

# Web Search Configuration
WEB_SEARCH_ENABLED=True  # Enable/disable web search functionality
WEB_SEARCH_CONTEXT_SIZE="medium"  # low, medium, high - controls search result context size

# Agent mode
AGENT_COMMAND=agent-chat
AGENT_PROMPT=
AGENT_CWD=/workspace
AGENT_MAX_TURNS=

# Flags
AGENT_SHOW_TRANSCRIPT=false
AGENT_DISABLE_CLAUDE_MD=false
AGENT_ALLOW_WRITE=false
AGENT_ALLOW_SHELL=false
AGENT_UNSAFE=false
AGENT_STREAM=true

# Optional tuning
AGENT_TEMPERATURE=0.0
AGENT_TIMEOUT_SECONDS=360.0
AGENT_COMPACT_PRESERVE_MESSAGES=4
