# OpenAI-compatible backend
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=gemma4:e4b

# SageMath MCP
SAGEMATH_IMAGE=sagemath/sagemath:latest
SAGEMATH_MCP_URL=http://127.0.0.1:18000/mcp

# Optional web search provider
# Local host run example: http://127.0.0.1:8080
# Dockerized agent example: http://host.docker.internal:8080
# SEARXNG_BASE_URL=http://host.docker.internal:8080
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=

# Agent mode
AGENT_COMMAND=agent-tui
AGENT_PROMPT=
AGENT_CWD=/workspace
HOST_WORKSPACE_DIR=.
# Leave blank to allow the agent to run until completion.
AGENT_MAX_TURNS=

# Flags
AGENT_SHOW_TRANSCRIPT=false
AGENT_DISABLE_CLAUDE_MD=false
AGENT_READ_ONLY=true
AGENT_ALLOW_WRITE=false
AGENT_ALLOW_SHELL=false
AGENT_UNSAFE=false
AGENT_STREAM=true

# Optional tuning
AGENT_TEMPERATURE=0.0
AGENT_TIMEOUT_SECONDS=120.0
AGENT_COMPACT_PRESERVE_MESSAGES=4
